# 服务器配置
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB配置
MONGODB_URI=mongodb://localhost:27017/secure_voice

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS配置
CORS_ORIGIN=*

# 速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
